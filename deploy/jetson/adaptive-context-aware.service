[Unit]
Description=Adaptive Context Aware Jetson Runtime
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/adaptive-context-aware
ExecStart=/usr/bin/docker compose -f docker/docker-compose.yml up -d control-api
ExecStop=/usr/bin/docker compose -f docker/docker-compose.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
