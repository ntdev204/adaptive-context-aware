FROM python:3.11-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_HOME=/app \
    CTX_ASTRAS_RGB_DEVICE=/dev/video0 \
    CTX_ASTRAS_DEPTH_DEVICE=/dev/video1 \
    CTX_ENGINE_CACHE_DIR=/app/models/engines \
    CTX_JETSON_HOST=25.12.4.100 \
    CTX_PI_HOST=25.12.4.101 \
    CTX_RESULT_PUBLISH_PORT=5556 \
    CTX_SENSOR_INGEST_PORT=5555 \
    CTX_HEARTBEAT_PORT=9093 \
    CTX_HEARTBEAT_INTERVAL_MS=500 \
    CTX_RUNTIME_BACKEND=engine

WORKDIR ${APP_HOME}

RUN apt-get -o Acquire::Retries=5 update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    coreutils \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY src ./src
COPY config ./config
COPY scripts ./scripts

RUN mkdir -p /app/models/engines && pip install --no-cache-dir -e .[engine]

RUN chmod +x /app/scripts/entrypoint.sh

ENTRYPOINT ["/app/scripts/entrypoint.sh"]
CMD ["python", "-m", "src.main"]
