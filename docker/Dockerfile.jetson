ARG L4T_TAG=r36.4.4

FROM python:3.10-slim AS mlflow

ENV PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN pip install --no-cache-dir mlflow

WORKDIR /srv/mlflow

EXPOSE 5000

CMD ["mlflow", "server"]

FROM dustynv/l4t-pytorch:${L4T_TAG} AS jetson-base

ENV PIP_INDEX_URL=https://pypi.org/simple \
    PIP_EXTRA_INDEX_URL=https://pypi.org/simple \
    PIP_RETRIES=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_HOME=/app \
    CTX_LOG_LEVEL=INFO \
    CTX_CAMERA_BACKEND=openni \
    CTX_CAMERA_SOURCE=device \
    CTX_ASTRAS_RGB_DEVICE=/dev/video0 \
    CTX_ASTRAS_DEPTH_DEVICE=/dev/video1 \
    CTX_ENGINE_CACHE_DIR=/app/models/engines \
    CTX_AUTOSTART=true \
    CTX_BIND_HOST=0.0.0.0 \
    CTX_JETSON_HOST=25.12.4.100 \
    CTX_PI_HOST=25.12.4.101 \
    CTX_SCADA_CAMERA_HOST=25.12.4.101 \
    CTX_SCADA_CAMERA_PORT=5557 \
    CTX_CAMERA_FRAME_TIMEOUT_MS=2000 \
    CTX_RESULT_PUBLISH_PORT=5556 \
    CTX_SENSOR_INGEST_PORT=5555 \
    CTX_HEARTBEAT_PORT=9093 \
    CTX_HEARTBEAT_INTERVAL_MS=500 \
    CTX_RUNTIME_BACKEND=engine \
    CTX_REQUIRE_ENGINE_AT_BOOT=false \
    CTX_PT_MODEL_PATH=/app/models/fine_tuning/best.pt \
    CTX_ENGINE_MODEL_PATH=/app/models/engines/best.engine \
    CTX_TRACKER_CONFIG_PATH=/app/models/fine_tuning/botsort_tuned.json \
    OPENNI_SDK_ROOT=/opt/orbbec/openni \
    OPENNI2_REDIST=/usr/lib \
    OPENNI2_DRIVERS_PATH=/usr/lib/OpenNI2/Drivers \
    YOLO_OFFLINE=True \
    ULTRALYTICS_TELEMETRY=0 \
    CUDA_MODULE_LOADING=LAZY \
    LD_LIBRARY_PATH=/usr/lib/aarch64-linux-gnu/nvidia:/usr/lib/aarch64-linux-gnu/tegra:$LD_LIBRARY_PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    build-essential \
    libglib2.0-0 \
    libgl1 \
    libgomp1 \
    libusb-1.0-0 \
    libudev-dev \
    usbutils \
    python-is-python3 \
    python3-opencv \
    rsync \
    openssh-client \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /tmp/orbbec && \
    curl -L https://github.com/orbbec/ros_astra_camera/archive/refs/heads/master.tar.gz \
        | tar -xz -C /tmp/orbbec --strip-components=1 && \
    mkdir -p /usr/lib/OpenNI2/Drivers /opt/orbbec/openni/lib /opt/orbbec/openni/Redist && \
    cp /tmp/orbbec/include/openni2_redist/arm64/libOpenNI2.so /usr/lib/libOpenNI2.so && \
    cp /tmp/orbbec/include/openni2_redist/arm64/libOpenNI2.so /opt/orbbec/openni/lib/libOpenNI2.so && \
    cp /tmp/orbbec/include/openni2_redist/arm64/libOpenNI2.so /opt/orbbec/openni/Redist/libOpenNI2.so && \
    cp -r /tmp/orbbec/include/openni2_redist/arm64/OpenNI2 /opt/orbbec/openni/Redist/ && \
    cp -r /tmp/orbbec/include/openni2_redist/arm64/OpenNI2/Drivers/* /usr/lib/OpenNI2/Drivers/ && \
    ldconfig && \
    rm -rf /tmp/orbbec

WORKDIR ${APP_HOME}

COPY pyproject.toml ./
COPY src ./src
COPY config ./config
COPY scripts ./scripts

RUN pip install --upgrade "typing_extensions>=4.12.2,<5.0.0"
RUN pip install -e .[engine]

RUN mkdir -p /app/models/engines /app/logs /app/data /data/models/torch
RUN chmod +x /app/scripts/entrypoint.sh

EXPOSE 5555 5556 5557 8080 9093

FROM jetson-base AS jetson-dev

RUN pip install --no-cache-dir pytest pytest-asyncio pytest-mock ruff httpx

CMD ["/bin/bash"]

FROM jetson-base AS jetson-prod

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=5).read()" || exit 1

ENTRYPOINT ["/app/scripts/entrypoint.sh"]
CMD ["uvicorn", "src.api.app:app", "--host", "0.0.0.0", "--port", "8080"]
