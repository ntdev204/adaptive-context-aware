# Dockerfile.engine — Export one or many .pt models → TensorRT .engine
#
# Build:
#   make build-engine
#
# Run (exports .engine to ./models/engines/ on the host):
#   docker run --gpus all --rm \
#     -v "$(pwd)/models:/app/models" \
#     ctx-aware:engine
#
# Output:
#   models/engines/*.engine
#
# Notes:
#   - Must be built and run on the TARGET machine (GPU architecture must match).
#   - Requires NVIDIA Container Toolkit: https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/install-guide.html
#   - Half-precision (FP16) is enabled by default for faster inference.

ARG L4T_TAG=r36.4.0
FROM dustynv/l4t-pytorch:${L4T_TAG} AS exporter

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_HOME=/app \
    PIP_INDEX_URL=https://pypi.org/simple \
    PIP_EXTRA_INDEX_URL=https://pypi.org/simple \
    PIP_RETRIES=1 \
    PIP_NO_CACHE_DIR=1 \
    # Optional single-file mode. Leave CTX_PT_MODEL_PATH empty to export all .pt under CTX_PT_MODEL_ROOT.
    CTX_PT_MODEL_PATH= \
    CTX_PT_MODEL_ROOT=/app/models \
    CTX_ENGINE_ROOT=/app/models/engines \
    # Destination for the generated .engine file in single-file mode
    CTX_ENGINE_OUTPUT=/app/models/engines/best.engine \
    # Export settings (can be overridden at docker run time)
    ENGINE_IMG_SIZE=640 \
    ENGINE_HALF=True \
    ENGINE_WORKSPACE_GB=4 \
    ENGINE_BATCH=1

WORKDIR ${APP_HOME}

RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade "typing_extensions>=4.12.2,<5.0.0"
RUN pip install --no-cache-dir ultralytics

# Copy only what the export script needs
COPY scripts/export_engine.py ./scripts/export_engine.py

# Create input/output directories. Model files are expected to be bind-mounted at runtime.
RUN mkdir -p /app/models/engines /app/models/fine_tuning

# Run the export at container start time so the output can be bind-mounted out.
# `dustynv/l4t-pytorch` exposes `python3` reliably, but not always `python`.
CMD ["python3", "scripts/export_engine.py"]
